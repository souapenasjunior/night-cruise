// Cloudflare hosting (Workers static assets): the game is a static site served from the repository root.
// What is not part of the site (tools, backend sources, docs) is listed in .assetsignore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-cruise",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
